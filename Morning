name: Утренняя сводка

on:
  schedule:
    # 02:37 UTC = 07:37 по Душанбе (UTC+5). Скрипт сам дождётся 08:00 и отправит.
    # Минуту 37 выбрали намеренно: в начале часа у GitHub самые большие задержки.
    - cron: "37 2 * * *"
  workflow_dispatch:   # ручной запуск кнопкой Run workflow (отправляет сразу, без ожидания)

permissions:
  contents: write      # чтобы сохранить список отправленных ссылок в репозиторий

concurrency:
  group: morning-bot
  cancel-in-progress: false

jobs:
  send:
    runs-on: ubuntu-24.04
    timeout-minutes: 50
    steps:
      - uses: actions/checkout@v4

      - name: Собрать и отправить сводку
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          SKIP_WAIT: ${{ github.event_name == 'workflow_dispatch' && '1' || '' }}
        run: python3 morning_bot.py

      - name: Сохранить список отправленных
        run: |
          git config user.name "morning-bot"
          git config user.email "morning-bot@users.noreply.github.com"
          git add sent.json
          git diff --staged --quiet || (git commit -m "Обновить список отправленных" && git push)
